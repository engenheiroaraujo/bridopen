# Exemplo de configuracao do Bridopen.
# Copie este arquivo para .env e substitua os valores.
# Tudo aqui e apenas exemplo: nunca comite um .env preenchido.

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# development ou production
BRIDOPEN_APP_ENV=development
BRIDOPEN_SERVER_PORT=5000
# URL publica absoluta da aplicacao. Em producao, use HTTPS.
BRIDOPEN_BASE_URL=http://localhost:5000
# debug, info, warn ou error
BRIDOPEN_LEVEL_LOG=info

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BASE?sslmode=disable
# O exemplo abaixo corresponde ao banco do docker-compose.local.yml.
BRIDOPEN_DB_CONN_URL=postgres://postgres:postgres@localhost:5434/postgres?sslmode=disable

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# O exemplo abaixo corresponde ao MailHog do docker-compose.local.yml.
BRIDOPEN_MAIL_HOST=localhost
BRIDOPEN_MAIL_PORT=1025
# Preencha com as credenciais do seu provedor SMTP em producao.
BRIDOPEN_MAIL_USERNAME=
BRIDOPEN_MAIL_PASSWORD=
BRIDOPEN_MAIL_FROM=nao-responder@exemplo.local

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
# Gere valores aleatorios fortes, com pelo menos 32 caracteres.
# Exemplo de geracao: openssl rand -base64 48
BRIDOPEN_CSRF_KEY=troque-esta-chave-de-desenvolvimento-por-uma-aleatoria
# Obrigatoria em producao. Use chave dedicada, diferente da BRIDOPEN_CSRF_KEY,
# e planeje a rotacao segura dos segredos criptografados.
BRIDOPEN_MFA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Cookies e origens
# ---------------------------------------------------------------------------
# Deve ser true em producao.
BRIDOPEN_COOKIE_SECURE=false
BRIDOPEN_COOKIE_DOMAIN=
# Lista separada por virgula com as origens aceitas pelo CSRF.
BRIDOPEN_TRUSTED_ORIGINS=localhost:5000,127.0.0.1:5000

# ---------------------------------------------------------------------------
# Anexos
# ---------------------------------------------------------------------------
BRIDOPEN_ATTACHMENT_STORAGE_DIR=storage/attachments
# Endereco do ClamAV. Opcional em desenvolvimento.
# Em producao com Docker, use clamav:3310.
BRIDOPEN_CLAMAV_ADDR=

# ---------------------------------------------------------------------------
# Exemplo de producao
# ---------------------------------------------------------------------------
# BRIDOPEN_APP_ENV=production
# BRIDOPEN_BASE_URL=https://seu-dominio.com.br
# BRIDOPEN_COOKIE_SECURE=true
# BRIDOPEN_TRUSTED_ORIGINS=seu-dominio.com.br,www.seu-dominio.com.br
# BRIDOPEN_ATTACHMENT_STORAGE_DIR=/data/attachments
# BRIDOPEN_CLAMAV_ADDR=clamav:3310
